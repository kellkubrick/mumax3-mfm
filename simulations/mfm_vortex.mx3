// MFM (Magnetic Force Microscopy) — стартовый сценарий MuMax3
// Документация: https://mumax.github.io/examples.html#magnetic-force-microscopy
//
// Запуск: mumax3 simulations/mfm_vortex.mx3
// Результаты: папка mfm_vortex.out/ (OVF, таблицы), веб-интерфейс по умолчанию http://127.0.0.1:35367

SetGridSize(256, 256, 1)
SetCellSize(2e-9, 2e-9, 1e-9)
SetGeom(rect(400e-9, 400e-9))

msat  = 600e3
aex   = 10e-12
alpha = 0.02

m = vortex(1, 1)

relax()
save(m)

// Высота подъёма зонда (м). Должна быть > 0.
MFMLift = 10e-9
saveas(MFM, "lift_10nm")

MFMLift = 40e-9
saveas(MFM, "lift_40nm")

MFMLift = 90e-9
saveas(MFM, "lift_90nm")

// Частично намагниченный наконечник (опционально): высота вертикально намагниченной части, м
// MFMDipole = 20e-9
